<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Wanderlust</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/listings">Wanderlust</a>
        </div>
    </nav>
    <div class="container mt-4 text-center">
        <h1 class="display-1">Error <%= statusCode || 500 %></h1>
        <p class="lead"><%= message || "Something went wrong!" %></p>
        <a href="/listings" class="btn btn-primary">Go to Listings</a>
    </div>
</body>
</html>
