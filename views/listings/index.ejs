<% layout('../layouts/boilerplate') -%>

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">All Travel Listings</h1>
    </div>
</div>

<div class="row">
    <% if(allListings && allListings.length > 0) { %>
        <% allListings.forEach(function(listing) { %>
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <% if(listing.image && listing.image.url) { %>
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 200px; object-fit: cover;">
                    <% } else { %>
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                    <% } %>
                    <div class="card-body">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text text-muted"><%= listing.location %>, <%= listing.country %></p>
                        <p class="card-text"><strong>$<%= listing.price %></strong> per night</p>
                        <a href="/listings/<%= listing._id %>" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="col-12">
            <div class="alert alert-info">
                <h4>No listings found</h4>
                <p>Be the first to create a travel listing!</p>
                <% if(typeof currUser !== 'undefined' && currUser) { %>
                    <a href="/listings/new" class="btn btn-primary">Create New Listing</a>
                <% } else { %>
                    <a href="/login" class="btn btn-primary">Login to Create Listing</a>
                <% } %>
            </div>
        </div>
    <% } %>
</div>
